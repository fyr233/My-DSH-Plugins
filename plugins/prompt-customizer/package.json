{
  "name": "@local/dsh-plugin-prompt-customizer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Persistently customize identity, persona prefix and suffix for top-level Harness agents, with live settings and restore defaults.",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0",
    "node": ">=22"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "scripts": {
    "test": "node --test --test-isolation=none core.test.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "core.js",
    "core.test.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "VERIFICATION.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
