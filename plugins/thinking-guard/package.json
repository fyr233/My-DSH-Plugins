{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@local/dsh-plugin-thinking-guard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Keep thinking out of the message body: reclassify leaked <thinking>/<analysis>/<summary> content into reasoning blocks as the model stream arrives, before it is assembled and stored.",
  "license": "MIT",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "test": "node test/check.mjs"
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0",
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
